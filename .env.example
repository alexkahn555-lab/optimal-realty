# ============================================================================
# OPTIMAL REALTY — ENVIRONMENT. Build reference v2.0, Appendix B.
# Copy to .env.local and fill. .env.local is gitignored; no real value is ever
# committed. The build succeeds with every value empty — /api/leads answers
# 503 naming its missing vars until its set is filled. Deferred integrations
# get no placeholder keys here.
# ============================================================================

# Canonical origin (D-06 — domain unselected). Unset or placeholder = site closed: robots full-disallow + noindex header on every response.
NEXT_PUBLIC_SITE_ORIGIN=

# Supabase project URL — server-side lead store.
SUPABASE_URL=
# Supabase service-role key — server only; NEVER takes a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key for lead notification email.
RESEND_API_KEY=
# From-address for lead mail — blocked on D-06 DKIM until the domain is chosen.
LEAD_FROM_ADDRESS=
# Broker inbox that receives lead notifications.
BROKER_NOTIFY_EMAIL=

# Cloudflare Turnstile server-side secret (bot verification).
TURNSTILE_SECRET=
# Turnstile site key (public; rendered by the lead form).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Salt for lead IP hashing. Rotating it resets rate-limit memory (acceptable).
LEAD_IP_SALT=

# CRM switch: 'null' = store-only; flipping to 'attio' is the entire cutover.
CRM_PROVIDER=
# Attio API key — read only when CRM_PROVIDER=attio.
ATTIO_API_KEY=
# Bearer secret guarding the CRM sync sweep (Vercel cron sends it automatically).
CRON_SECRET=

# Content gate: 1 = strict (TK markers fail the build; production from Phase 6), else report-only.
CONTENT_STRICT=
